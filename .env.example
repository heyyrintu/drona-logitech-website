# Verified public origin used for canonical URLs, sitemap, and indexing.
# No trailing slash. Leave blank on staging to keep the build no-indexed.
NEXT_PUBLIC_SITE_URL=

# Public enquiry address. Published on the contact page, in the footer, and in
# the Organization JSON-LD, so it must be a real monitored inbox.
NEXT_PUBLIC_CONTACT_EMAIL=info@dronalogitech.com

# Web3Forms access key - required for the enquiry form to send.
#
# Get one free at https://web3forms.com: enter the inbox above, and the key
# arrives by email. No account needed.
#
# This key is designed to be public and is baked into the client bundle by
# NEXT_PUBLIC_. That is expected; it only authorises posting to the inbox it
# was issued for. Rotate it from the Web3Forms dashboard if it gets abused.
#
# Without this key the form renders but cannot send, and tells visitors to
# email the address above directly.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
